# Copy to .env and fill in. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Defaults to claude-opus-5-5. Set to claude-opus-5 to roll back.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Set to 1 to show full tracebacks in the UI.
# FPR_DEBUG=1

# Optional: pull league data directly from ESPN instead of uploading screenshots.
# Both cookies come from your browser at fantasy.espn.com (DevTools > Application
# > Cookies). ESPN_S2 is a full account session token -- treat it as a password.
# The per-league ID is set on each league's page in the app, not here.
# ESPN_S2=
# ESPN_SWID={00000000-0000-0000-0000-000000000000}
